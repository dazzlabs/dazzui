{
  "id": "text-field",
  "name": "TextField",
  "summary": "A line of text, or several, that a person writes.",
  "preview": {
    "id": "text-field/preview",
    "title": "Preview",
    "content": {
      "$el": "Col",
      "props": {
        "width": "15rem"
      },
      "children": [
        {
          "$el": "TextField",
          "props": {
            "placeholder": "you@example.com",
            "aria-label": "Email"
          },
          "$at": 0
        }
      ]
    },
    "gaps": []
  },
  "examples": [
    {
      "id": "text-field/0",
      "title": "Sizes",
      "content": {
        "$el": "Col",
        "props": {
          "width": "20rem"
        },
        "children": [
          {
            "$el": "TextField",
            "props": {
              "size": "small",
              "placeholder": "Small",
              "aria-label": "Small"
            },
            "$at": 0
          },
          {
            "$el": "TextField",
            "props": {
              "size": "medium",
              "placeholder": "Medium",
              "aria-label": "Medium"
            },
            "$at": 1
          },
          {
            "$el": "TextField",
            "props": {
              "size": "large",
              "placeholder": "Large",
              "aria-label": "Large"
            },
            "$at": 2
          }
        ]
      },
      "gaps": []
    },
    {
      "id": "text-field/1",
      "title": "States",
      "content": {
        "$el": "Col",
        "props": {
          "width": "20rem"
        },
        "children": [
          {
            "$el": "TextField",
            "props": {
              "defaultValue": "Filled in",
              "aria-label": "Filled"
            },
            "$at": 0
          },
          {
            "$el": "TextField",
            "props": {
              "state": "error",
              "defaultValue": "not-an-email",
              "aria-label": "Error"
            },
            "$at": 1
          },
          {
            "$el": "TextField",
            "props": {
              "disabled": true,
              "defaultValue": "Disabled",
              "aria-label": "Disabled"
            },
            "$at": 2
          },
          {
            "$el": "TextField",
            "props": {
              "mono": true,
              "defaultValue": "sk-4f9a…c21e",
              "aria-label": "Key"
            },
            "$at": 3
          }
        ]
      },
      "gaps": []
    },
    {
      "id": "text-field/2",
      "title": "Multiline",
      "content": {
        "$el": "Col",
        "props": {
          "width": "20rem"
        },
        "children": [
          {
            "$el": "TextField",
            "props": {
              "multiline": true,
              "rows": 3,
              "placeholder": "Anything the reviewer should know",
              "aria-label": "Notes"
            },
            "$at": 0
          },
          {
            "$el": "TextField",
            "props": {
              "multiline": true,
              "rows": 5,
              "defaultValue": "Rows open the box past its floor: five lines of prose leading, its padding and its border.",
              "aria-label": "Description"
            },
            "$at": 1
          }
        ]
      },
      "gaps": []
    }
  ]
}
