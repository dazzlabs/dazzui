{
  "id": "option-card",
  "name": "OptionCard",
  "summary": "One of a few, where each needs a sentence to be chosen by.",
  "preview": {
    "id": "option-card/preview",
    "title": "Preview",
    "state": {
      "s0": "team"
    },
    "content": {
      "$el": "Row",
      "props": {
        "align": "stretch",
        "width": "100%"
      },
      "children": [
        {
          "$el": "OptionCard",
          "props": {
            "title": "Free",
            "description": "Three projects, one seat.",
            "selected": {
              "$eq": [
                {
                  "$state": "s0"
                },
                "free"
              ]
            },
            "onClick": {
              "$do": [
                {
                  "set": "s0",
                  "to": "free"
                }
              ]
            }
          },
          "$at": 0
        },
        {
          "$el": "OptionCard",
          "props": {
            "title": "Team",
            "description": "Unlimited projects.",
            "selected": {
              "$eq": [
                {
                  "$state": "s0"
                },
                "team"
              ]
            },
            "onClick": {
              "$do": [
                {
                  "set": "s0",
                  "to": "team"
                }
              ]
            }
          },
          "$at": 1
        }
      ]
    },
    "gaps": []
  },
  "examples": [
    {
      "id": "option-card/0",
      "title": "Choosing one",
      "state": {
        "s0": "team"
      },
      "content": {
        "$el": "Row",
        "props": {
          "align": "stretch",
          "width": "100%"
        },
        "children": [
          {
