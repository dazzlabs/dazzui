            "props": {
              "title": "Free",
              "description": "Three projects, one seat.",
              "selected": {
                "$eq": [
                  {
                    "$state": "s0"
                  },
                  "free"
                ]
              },
              "onClick": {
                "$do": [
                  {
                    "set": "s0",
                    "to": "free"
                  }
                ]
              }
            },
            "$at": 0
          },
          {
            "$el": "OptionCard",
            "props": {
              "title": "Team",
              "description": "Unlimited projects.",
              "selected": {
                "$eq": [
                  {
                    "$state": "s0"
                  },
                  "team"
                ]
              },
              "onClick": {
                "$do": [
                  {
                    "set": "s0",
                    "to": "team"
                  }
                ]
              }
            },
            "$at": 1
          },
          {
            "$el": "OptionCard",
            "props": {
              "title": "Business",
              "description": "SSO and audit log.",
              "selected": {
                "$eq": [
                  {
                    "$state": "s0"
                  },
