    {
      "id": "option-card/1",
      "title": "Disabled",
      "content": {
        "$el": "Row",
        "props": {
          "align": "stretch"
        },
        "children": [
          {
            "$el": "OptionCard",
            "props": {
              "title": "Enterprise",
              "description": "Talk to us.",
              "disabled": true
            },
            "$at": 0
          }
        ]
      },
      "gaps": []
