{
  "id": "checkbox",
  "name": "Checkbox",
  "summary": "A choice that stands on its own, or one of several that may all hold.",
  "preview": {
    "id": "checkbox/preview",
    "title": "Preview",
    "content": {
      "$el": "Col",
      "children": [
        {
          "$el": "Checkbox",
          "props": {
            "defaultChecked": true
          },
          "children": [
            "Send me the digest"
          ],
          "$at": 0
        },
        {
          "$el": "Checkbox",
          "children": [
            "Include archived projects"
          ],
          "$at": 1
        }
      ]
    },
    "gaps": []
  },
  "examples": [
    {
      "id": "checkbox/0",
      "title": "States",
      "content": {
        "$el": "Col",
        "children": [
          {
            "$el": "Checkbox",
            "children": [
              "Unchecked"
            ],
            "$at": 0
          },
          {
            "$el": "Checkbox",
            "props": {
              "defaultChecked": true
            },
            "children": [
              "Checked"
            ],
            "$at": 1
          },
          {
            "$el": "Checkbox",
            "props": {
              "indeterminate": true
            },
            "children": [
              "Indeterminate"
            ],
            "$at": 2
          },
          {
            "$el": "Checkbox",
            "props": {
              "disabled": true,
              "defaultChecked": true
            },
            "children": [
              "Disabled"
            ],
            "$at": 3
          }
        ]
      },
      "gaps": []
    },
    {
      "id": "checkbox/1",
      "title": "With a note",
      "content": {
        "$el": "Checkbox",
        "props": {
          "defaultChecked": true,
          "note": "Once a week, on Monday morning."
        },
        "children": [
          "Send me the digest"
        ],
        "$at": 0
      },
      "gaps": []
    },
    {
      "id": "checkbox/2",
      "title": "Tints",
      "content": {
        "$el": "Row",
        "props": {
          "gap": "5"
        },
        "children": [
          {
            "$el": "Checkbox",
            "props": {
              "tint": "primary",
              "defaultChecked": true
            },
            "children": [
              "primary"
            ],
            "$at": 0
          },
          {
            "$el": "Checkbox",
            "props": {
              "tint": "neutral",
              "defaultChecked": true
            },
            "children": [
              "neutral"
            ],
            "$at": 1
          },
          {
            "$el": "Checkbox",
            "props": {
              "tint": "info",
              "defaultChecked": true
            },
            "children": [
              "info"
            ],
            "$at": 2
          },
          {
            "$el": "Checkbox",
            "props": {
              "tint": "success",
              "defaultChecked": true
            },
            "children": [
              "success"
            ],
            "$at": 3
          },
          {
            "$el": "Checkbox",
            "props": {
              "tint": "warning",
              "defaultChecked": true
            },
            "children": [
              "warning"
            ],
            "$at": 4
          },
          {
            "$el": "Checkbox",
            "props": {
              "tint": "danger",
              "defaultChecked": true
            },
            "children": [
              "danger"
            ],
            "$at": 5
          }
        ]
      },
      "gaps": []
    }
  ]
}
