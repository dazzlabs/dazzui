{
  "id": "collapsible",
  "name": "Collapsible",
  "summary": "One section that can be put away.",
  "preview": {
    "id": "collapsible/preview",
    "title": "Preview",
    "content": {
      "$el": "Col",
      "props": {
        "width": "18rem"
      },
      "children": [
        {
          "$el": "Collapsible",
          "props": {
            "title": "Advanced",
            "defaultOpen": true
          },
          "children": [
            "Options most people never change."
          ],
          "$at": 0
        }
      ]
    },
    "gaps": []
  },
  "examples": [
    {
      "id": "collapsible/0",
      "title": "Open and closed",
      "content": {
        "$el": "Col",
        "props": {
          "width": "28rem"
        },
        "children": [
          {
            "$el": "Collapsible",
            "props": {
              "title": "Build log",
              "defaultOpen": true
            },
            "children": [
              "Compiled 214 modules in 1.8 seconds."
            ],
            "$at": 0
          },
          {
            "$el": "Collapsible",
            "props": {
              "title": "Test log"
            },
            "children": [
              "All 37 tests passed."
            ],
            "$at": 1
          }
        ]
      },
      "gaps": []
    },
    {
      "id": "collapsible/1",
      "title": "With something beside the title",
      "content": {
        "$el": "Col",
        "props": {
          "width": "28rem"
        },
        "children": [
          {
            "$el": "Collapsible",
            "props": {
              "title": "Warnings",
              "meta": {
                "$el": "Badge",
                "props": {
                  "tint": "warning"
                },
                "children": [
                  "3"
                ],
                "$at": 1
              },
              "defaultOpen": true
            },
            "children": [
              "Three imports are unused."
            ],
            "$at": 0
          }
        ]
      },
      "gaps": []
    }
  ]
}
