{
  "id": "skeleton",
  "name": "Skeleton",
  "summary": "The shape of what is coming, while it is on its way.",
  "preview": {
    "id": "skeleton/preview",
    "title": "Preview",
    "content": {
      "$el": "Row",
      "props": {
        "width": "15rem"
      },
      "children": [
        {
          "$el": "Skeleton",
          "props": {
            "shape": "circle",
            "width": 36,
            "height": 36
          },
          "$at": 0
        },
        {
          "$el": "Col",
          "props": {
            "width": "10rem",
            "gap": "2"
          },
          "children": [
            {
              "$el": "Skeleton",
              "props": {
                "width": "80%"
              },
              "$at": 1
            },
            {
              "$el": "Skeleton",
              "props": {
                "width": "50%"
              },
              "$at": 2
            }
          ]
        }
      ]
    },
    "gaps": []
  },
  "examples": [
    {
      "id": "skeleton/0",
      "title": "Shapes",
      "content": {
        "$el": "Row",
        "props": {
          "gap": "5"
        },
        "children": [
          {
            "$el": "Skeleton",
            "props": {
              "shape": "text",
              "width": 120
            },
            "$at": 0
          },
          {
            "$el": "Skeleton",
            "props": {
              "shape": "circle",
              "width": 40,
              "height": 40
            },
            "$at": 1
          },
          {
            "$el": "Skeleton",
            "props": {
              "shape": "rect",
              "width": 120,
              "height": 64
            },
            "$at": 2
          }
        ]
      },
      "gaps": []
    },
    {
      "id": "skeleton/1",
      "title": "A paragraph",
      "content": {
        "$el": "Col",
        "props": {
          "width": "22rem"
        },
        "children": [
          {
            "$el": "SkeletonText",
            "props": {
              "lines": 4
            },
            "$at": 0
          }
        ]
      },
      "gaps": []
    },
    {
      "id": "skeleton/2",
      "title": "In a card",
      "content": {
        "$el": "Col",
        "props": {
          "width": "20rem"
        },
        "children": [
          {
            "$el": "Card",
            "children": [
              {
                "$el": "Row",
                "children": [
                  {
                    "$el": "Skeleton",
                    "props": {
                      "shape": "circle",
                      "width": 36,
                      "height": 36
                    },
                    "$at": 1
                  },
                  {
                    "$el": "Col",
                    "props": {
                      "width": "12rem",
                      "gap": "2"
                    },
                    "children": [
                      {
                        "$el": "Skeleton",
                        "props": {
                          "width": "70%"
                        },
                        "$at": 2
                      },
                      {
                        "$el": "Skeleton",
                        "props": {
                          "width": "40%"
                        },
                        "$at": 3
                      }
                    ]
                  }
                ]
              }
            ],
            "$at": 0
          }
        ]
      },
      "gaps": []
    }
  ]
}
