{
  "id": "preferences",
  "name": "Preferences",
  "summary": "Settings, a row to each, in the sections they belong to.",
  "preview": {
    "id": "preferences/preview",
    "title": "Preview",
    "content": {
      "$el": "Col",
      "props": {
        "width": "20rem"
      },
      "children": [
        {
          "$el": "Preferences",
          "children": [
            {
              "$el": "PreferenceSection",
              "props": {
                "label": "General"
              },
              "children": [
                {
                  "$el": "PreferenceRow",
                  "props": {
                    "title": "Launch at login"
                  },
                  "children": [
                    {
                      "$el": "Switch",
                      "props": {
                        "defaultChecked": true,
                        "aria-label": "Launch at login"
                      },
                      "$at": 3
                    }
                  ],
                  "$at": 2
                },
                {
                  "$el": "PreferenceRow",
                  "props": {
                    "title": "Send crash reports"
                  },
                  "children": [
                    {
                      "$el": "Switch",
                      "props": {
                        "aria-label": "Send crash reports"
                      },
                      "$at": 5
                    }
                  ],
                  "$at": 4
                }
              ],
              "$at": 1
            }
          ],
          "$at": 0
        }
      ]
    },
    "gaps": []
  },
  "examples": [
    {
      "id": "preferences/0",
      "title": "A section",
      "content": {
        "$el": "Col",
        "props": {
          "width": "32rem"
        },
        "children": [
          {
            "$el": "Preferences",
            "children": [
              {
                "$el": "PreferenceSection",
                "props": {
                  "label": "General"
                },
                "children": [
                  {
                    "$el": "PreferenceRow",
                    "props": {
                      "title": "Language",
                      "subtitle": "What the interface is set in"
                    },
                    "children": [
                      {
                        "$el": "Select",
                        "props": {
                          "size": "small",
                          "options": [
                            {
                              "value": "en",
                              "label": "English"
                            },
                            {
                              "value": "zh",
                              "label": "Chinese"
                            }
                          ],
                          "defaultValue": "en",
                          "aria-label": "Language"
                        },
                        "$at": 3
                      }
                    ],
                    "$at": 2
                  },
                  {
                    "$el": "PreferenceRow",
                    "props": {
                      "title": "Launch at login"
                    },
                    "children": [
                      {
                        "$el": "Switch",
                        "props": {
                          "defaultChecked": true,
                          "aria-label": "Launch at login"
                        },
                        "$at": 5
                      }
                    ],
                    "$at": 4
                  },
                  {
                    "$el": "PreferenceRow",
                    "props": {
                      "title": "Check for updates"
                    },
                    "children": [
                      {
                        "$el": "Button",
                        "props": {
                          "size": "small"
                        },
                        "children": [
                          "Check now"
                        ],
                        "$at": 7
                      }
                    ],
                    "$at": 6
                  }
                ],
                "$at": 1
              }
            ],
            "$at": 0
          }
        ]
      },
      "gaps": []
    },
    {
      "id": "preferences/1",
      "title": "A group of sections",
      "content": {
        "$el": "Col",
        "props": {
          "width": "32rem"
        },
        "children": [
          {
            "$el": "Preferences",
            "children": [
              {
                "$el": "PreferenceGroup",
                "props": {
                  "title": "Application",
                  "description": "How the app behaves on this computer."
                },
                "children": [
                  {
                    "$el": "PreferenceSection",
                    "props": {
                      "label": "General"
                    },
                    "children": [
                      {
                        "$el": "PreferenceRow",
                        "props": {
                          "title": "Language",
                          "subtitle": "What the interface is set in"
                        },
                        "children": [
                          {
                            "$el": "Select",
                            "props": {
                              "size": "small",
                              "options": [
                                {
                                  "value": "en",
                                  "label": "English"
                                },
                                {
                                  "value": "zh",
                                  "label": "Chinese"
                                }
                              ],
                              "defaultValue": "en",
                              "aria-label": "Language"
                            },
                            "$at": 4
                          }
                        ],
                        "$at": 3
                      },
                      {
                        "$el": "PreferenceRow",
                        "props": {
                          "title": "Launch at login"
                        },
                        "children": [
                          {
                            "$el": "Switch",
                            "props": {
                              "defaultChecked": true,
                              "aria-label": "Launch at login"
                            },
                            "$at": 6
                          }
                        ],
                        "$at": 5
                      },
                      {
                        "$el": "PreferenceRow",
                        "props": {
                          "title": "Check for updates"
                        },
                        "children": [
                          {
                            "$el": "Button",
                            "props": {
                              "size": "small"
                            },
                            "children": [
                              "Check now"
                            ],
                            "$at": 8
                          }
                        ],
                        "$at": 7
                      }
                    ],
                    "$at": 2
                  },
                  {
                    "$el": "PreferenceSection",
                    "props": {
                      "label": "Privacy",
                      "footer": "Reports never include your files."
                    },
                    "children": [
                      {
                        "$el": "PreferenceRow",
                        "props": {
                          "title": "Send crash reports"
                        },
                        "children": [
                          {
                            "$el": "Switch",
                            "props": {
                              "aria-label": "Send crash reports"
                            },
                            "$at": 11
                          }
                        ],
                        "$at": 10
                      }
                    ],
                    "$at": 9
                  }
                ],
                "$at": 1
              }
            ],
            "$at": 0
          }
        ]
      },
      "gaps": []
    },
    {
      "id": "preferences/2",
      "title": "Rows that open something",
      "content": {
        "$el": "Col",
        "props": {
          "width": "32rem"
        },
        "children": [
          {
            "$el": "Preferences",
            "children": [
              {
                "$el": "PreferenceSection",
                "props": {
                  "label": "Account"
                },
                "children": [
                  {
                    "$el": "PreferenceRow",
                    "props": {
                      "title": "Profile",
                      "subtitle": "Name and picture",
                      "onOpen": {
                        "$do": []
                      }
                    },
                    "$at": 2
                  },
                  {
                    "$el": "PreferenceRow",
                    "props": {
                      "title": "Billing",
                      "onOpen": {
                        "$do": []
                      }
                    },
                    "$at": 3
                  }
                ],
                "$at": 1
              }
            ],
            "$at": 0
          }
        ]
      },
      "gaps": []
    }
  ]
}
