    "row": {
      "size": {
        "$type": "dimension",
        "$value": "{control.small.size}"
      },
      "gap": {
        "$type": "dimension",
        "$value": "{control.medium.gap}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.small}"
      },
      "title": {
        "$type": "typography",
        "$value": "{labelSmall}"
      },
