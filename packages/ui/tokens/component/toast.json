{
  "toast": {
    "surface": {
      "$type": "color",
      "$value": "{color.surface}"
    },
    "border": {
      "$type": "color",
      "$value": "{color.border}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.large}"
    },
    "elevation": {
      "$type": "shadow",
      "$value": "{shadow.lg}"
    },
    "size": {
      "$type": "dimension",
      "$value": "{spacing.9}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{control.medium.gap}"
    },
    "padding": {
      "block": {
        "$type": "dimension",
        "$value": "{spacing.1.5}"
      },
      "inline": {
        "$type": "dimension",
        "$value": "{spacing.3}"
      }
    },
    "content": {
      "$type": "typography",
      "$value": "{labelSmall}"
    },
    "viewport": {
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.2}"
      },
      "padding": {
        "$type": "dimension",
        "$value": "{spacing.4}"
      }
    }
  }
}
