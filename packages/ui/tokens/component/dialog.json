{
  "dialog": {
    "surface": {
      "$type": "color",
      "$value": "{color.surface}"
    },
    "border": {
      "$type": "color",
      "$value": "{color.border}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.big}"
    },
    "elevation": {
      "$type": "shadow",
      "$value": "{shadow.xl}"
    },
    "width": {
      "$type": "dimension",
      "$value": "27.5rem"
    },
    "scrim": {
      "color": {
        "$type": "color",
        "$value": "{color.neutral.950}"
      },
      "alpha": {
        "$type": "number",
        "$value": 0.25
      },
      "padding": {
        "$type": "dimension",
        "$value": "{spacing.6}"
      }
    },
    "header": {
      "padding": {
        "block": {
          "$type": "dimension",
          "$value": "{spacing.3}"
        },
        "inline": {
          "$type": "dimension",
          "$value": "{spacing.5}"
        }
      },
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.1}"
      },
      "title": {
        "$type": "typography",
        "$value": "{titleSmall}"
      },
      "subtitle": {
        "$type": "typography",
        "$value": "{captionMedium}"
      }
    },
    "body": {
      "padding": {
        "block": {
          "$type": "dimension",
          "$value": "{spacing.4}"
        },
        "inline": {
          "$type": "dimension",
          "$value": "{spacing.5}"
        }
      },
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.4}"
      }
    },
    "footer": {
      "surface": {
        "$type": "color",
        "$value": "{color.surface-muted}"
      },
      "padding": {
        "block": {
          "$type": "dimension",
          "$value": "{spacing.3}"
        },
        "inline": {
          "$type": "dimension",
          "$value": "{spacing.5}"
        }
      },
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.2}"
      }
    }
  }
}
