{
  "button": {
    "small": {
      "size": {
        "$type": "dimension",
        "$value": "{control.small.size}"
      },
      "padding": {
        "block": {
          "$type": "dimension",
          "$value": "{control.small.padding.block}"
        },
        "inline": {
          "$type": "dimension",
          "$value": "{control.small.padding.inline}"
        }
      },
      "content": {
        "$type": "typography",
        "$value": "{labelSmall}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.small}"
      }
    },
    "medium": {
