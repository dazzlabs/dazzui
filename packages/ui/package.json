{
  "name": "@dazzlabs/dazzui",
  "version": "0.0.0",
  "description": "DazzUI design tokens and React components",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "tokens"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./components.css": "./dist/components.css",
    "./tokens/*": "./tokens/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run tokens && pnpm run lib",
    "tokens": "node scripts/build.mjs",
    "lib": "vite build",
    "sync": "node scripts/build.mjs --sync",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@terrazzo/cli": "^0.10.3",
    "@terrazzo/plugin-css": "^0.10.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "react": "^19.2.7",
    "typescript": "~6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3"
  }
}
