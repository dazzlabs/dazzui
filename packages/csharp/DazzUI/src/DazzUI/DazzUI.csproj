<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>DazzUI</AssemblyName>
    <RootNamespace>DazzUI</RootNamespace>
    <Description>DazzUI design system for WinUI 3.</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Generated/tokens.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Fluent System Icons React draws, by name. -->
    <PackageReference Include="FluentIcons.WinUI" Version="2.2.343" />
    <Using Include="FluentIcons.Common.Icon" Alias="Glyph" />
  </ItemGroup>
</Project>
