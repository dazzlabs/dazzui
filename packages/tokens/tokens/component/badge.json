{
  "badge": {
    "small": {
      "padding": {
        "block": {
          "$type": "dimension",
          "$value": "{control.tiny.padding.block}"
        },
        "inline": {
          "$type": "dimension",
          "$value": "{control.tiny.padding.inline}"
        }
      },
      "content": {
        "$type": "typography",
        "$value": "{captionSmall}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.small}"
      }
    },
    "medium": {
      "padding": {
        "block": {
          "$type": "dimension",
          "$value": "{control.small.padding.block}"
        },
        "inline": {
          "$type": "dimension",
          "$value": "{control.small.padding.inline}"
        }
      },
      "content": {
        "$type": "typography",
        "$value": "{captionMedium}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.medium}"
      }
    },
    "large": {
      "padding": {
        "block": {
          "$type": "dimension",
          "$value": "{control.medium.padding.block}"
        },
        "inline": {
          "$type": "dimension",
          "$value": "{control.medium.padding.inline}"
        }
      },
      "content": {
        "$type": "typography",
        "$value": "{captionLarge}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.large}"
      }
    }
  }
}
