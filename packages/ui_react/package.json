{
  "name": "@dazzlabs/dazzui-react",
  "version": "0.0.0",
  "description": "React components for DazzUI",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src/generated"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./src/generated/style.css",
    "./components.css": "./dist/components.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "react": "^19.2.7",
    "typescript": "~6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3"
  }
}
