  "InAGrid": {
    "content": {
      "component": "Box",
      "props": {
        "role": "radiogroup",
        "width": 704
      },
      "children": [
        {
          "component": "Grid",
          "props": {
            "min": 208
          },
          "children": [
            {
              "component": "OptionCard",
              "props": {
                "description": "20,000 characters a month, one provider."
              },
              "derive": {
                "selected": {
                  "eq": [
                    {
                      "state": "plan"
                    },
                    "free"
                  ]
                }
              },
              "on": {
                "press": {
                  "set": "plan",
                  "value": "free"
                }
              },
              "slots": {
                "title": {
                  "component": "Box",
                  "props": {
                    "display": "flex",
                    "align": "center",
                    "gap": "spacing.2"
                  },
                  "children": [
                    "Free"
                  ]
                }
              }
            },
            {
              "component": "OptionCard",
              "props": {
                "description": "Unlimited characters, every provider, shared glossaries."
              },
              "derive": {
                "selected": {
                  "eq": [
                    {
                      "state": "plan"
                    },
                    "pro"
                  ]
                }
              },
              "on": {
                "press": {
                  "set": "plan",
                  "value": "pro"
                }
              },
              "slots": {
                "title": {
                  "component": "Box",
                  "props": {
                    "display": "flex",
                    "align": "center",
                    "gap": "spacing.2"
                  },
                  "children": [
                    "Pro",
                    {
                      "component": "Badge",
                      "props": {
                        "size": "small",
                        "tint": "primary"
                      },
                      "children": [
                        "Current"
                      ]
                    }
                  ]
                }
              }
            },
            {
