  "Advancing": {
    "state": {
      "stage": 0
    },
    "timers": [
      {
        "every": 1400,
        "set": "stage",
        "value": {
          "if": {
            "gte": [
              {
                "state": "stage"
              },
              5
            ]
          },
          "then": 0,
          "else": {
            "add": [
              {
                "state": "stage"
              },
              1
            ]
          }
        }
      }
    ],
    "content": {
      "component": "Box",
      "props": {
        "width": 416
      },
