                  },
                  "derive": {
                    "status": {
                      "if": {
                        "gte": [
                          {
                            "state": "stage"
                          },
                          1
                        ]
                      },
                      "then": "done",
                      "else": {
                        "if": {
                          "eq": [
                            {
                              "state": "stage"
                            },
                            0
                          ]
                        },
                        "then": "active",
                        "else": "idle"
                      }
                    },
                    "meta": {
                      "if": {
                        "gte": [
