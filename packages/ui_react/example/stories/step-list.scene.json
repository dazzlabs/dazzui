            {
              "component": "Progress",
              "id": "progress",
              "derive": {
                "value": {
                  "multiply": [
                    {
                      "state": "stage"
                    },
                    20
                  ]
                }
              }
            },
            {
              "component": "StepList",
              "children": [
                {
                  "component": "Step",
                  "id": "stage-0",
                  "props": {
