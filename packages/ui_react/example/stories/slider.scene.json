  "Interactive": {
    "content": {
      "component": "Box",
      "props": {
        "width": 352
      },
      "children": [
        {
          "component": "FormField",
          "props": {
            "label": "Editor font size"
          },
          "derive": {
            "hint": {
              "concat": [
                {
                  "text": {
                    "state": "size"
                  }
                },
                "px"
              ]
            }
          },
          "children": [
            {
              "component": "Slider",
              "props": {
                "min": 8,
                "max": 24,
                "showValue": true,
                "unit": "px"
              },
              "bind": {
                "value": "size"
              }
            }
          ]
        }
      ]
    },
    "state": {
      "size": 13
    }
