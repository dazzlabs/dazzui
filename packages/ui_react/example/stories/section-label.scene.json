  "Overview": {
    "content": {
      "component": "Page",
      "props": {
        "title": "SectionLabel",
        "description": "The micro-heading that organises a pane. Sentence case, no uppercasing and no added tracking — one size covers sidebars, rails, and pane headings, so tone is the only axis worth varying. `SidebarGroupLabel` and `PreferenceSection` both render one for you; this is what those are made of."
      },
      "children": [
        {
          "component": "Section",
          "props": {
            "title": "Tints",
            "description": "Untinted it takes the muted content colour, which is what a heading almost always wants. A tint moves it onto a ramp, for a heading that has to carry a state with it — a section reporting a failure, a group flagged for review."
          },
          "children": [
            {
              "component": "Stack",
              "children": [
                {
                  "component": "Specimen",
                  "props": {
                    "label": "default"
                  },
