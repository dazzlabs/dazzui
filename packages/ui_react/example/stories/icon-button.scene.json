                      "component": "IconButton",
                      "props": {
                        "label": "Copy (plain)",
                        "variant": "plain"
                      },
                      "children": [
                        {
                          "component": "Icon",
                          "props": {
                            "name": "Copy20Regular",
                            "size": 16
                          }
                        }
