  "InAForm": {
    "content": {
      "component": "Box",
      "props": {
        "width": 288
      },
      "children": [
        {
          "component": "FormField",
          "props": {
            "label": "Dev server port"
          },
          "derive": {
            "hint": {
              "if": {
                "eq": [
                  {
                    "state": "port"
                  },
                  ""
                ]
              },
              "then": "Required",
              "else": "Restart to apply"
            },
            "state": {
              "if": {
                "eq": [
                  {
                    "state": "port"
                  },
                  ""
                ]
              },
              "then": "error",
              "else": "default"
            }
          },
          "children": [
            {
              "component": "NumberField",
              "props": {
                "min": 1024,
                "max": 65535
              },
              "derive": {
                "state": {
                  "if": {
                    "eq": [
                      {
                        "state": "port"
                      },
                      ""
                    ]
                  },
                  "then": "error",
                  "else": "default"
                }
              },
              "bind": {
                "value": "port"
              }
            }
          ]
        }
      ]
    },
    "state": {
      "port": "5173"
    }
  }
}
