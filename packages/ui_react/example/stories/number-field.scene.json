              ]
            },
            {
              "component": "PreferenceRow",
              "props": {
                "title": "Tab width"
              },
              "children": [
                {
                  "component": "Box",
                  "props": {
                    "width": 112
                  },
                  "children": [
                    {
                      "component": "NumberField",
                      "props": {
                        "min": 1,
                        "max": 8,
                        "size": "small"
                      },
                      "bind": {
                        "value": "number-field-2"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
