  "InSettings": {
    "content": {
      "component": "Box",
      "props": {
        "width": 480
      },
      "children": [
        {
          "component": "PreferenceSection",
          "props": {
            "label": "Editor"
          },
          "children": [
            {
              "component": "PreferenceRow",
              "props": {
                "title": "Font size",
                "subtitle": "Applies to every project"
              },
              "children": [
                {
                  "component": "Box",
                  "props": {
                    "width": 112
                  },
                  "children": [
                    {
                      "component": "NumberField",
                      "props": {
                        "min": 8,
