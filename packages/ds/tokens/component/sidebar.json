{
  "sidebar": {
    "width": {
      "$type": "dimension",
      "$value": "{frame.sidebar.width}"
    },
    "surface": {
      "$type": "color",
      "$value": "{color.surface-muted}"
    },
    "border": {
      "$type": "color",
      "$value": "{color.border}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{spacing.1}"
    },
    "padding": {
      "block": {
        "$type": "dimension",
        "$value": "{spacing.3.5}"
      },
      "inline": {
        "$type": "dimension",
        "$value": "{spacing.2.5}"
      }
    },
    "group": {
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.3.5}"
      }
    },
    "header": {
      "size": {
        "$type": "dimension",
        "$value": "{frame.titlebar.size}"
      },
      "padding": {
        "inline": {
          "$type": "dimension",
          "$value": "{spacing.4}"
        }
      }
    },
    "card": {
      "surface": {
        "$type": "color",
        "$value": "{color.surface}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.medium}"
      },
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.2}"
      },
      "padding": {
        "$type": "dimension",
        "$value": "{spacing.3}"
      }
    },
    "resizer": {
      "size": {
        "$type": "dimension",
        "$value": "{spacing.2}"
      }
    }
  }
}
