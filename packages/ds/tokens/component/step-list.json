{
  "step-list": {
    "gap": {
      "$type": "dimension",
      "$value": "{spacing.2}"
    },
    "step": {
      "gap": {
        "$type": "dimension",
        "$value": "{control.medium.gap}"
      },
      "content": {
        "$type": "typography",
        "$value": "{labelSmall}"
      },
      "meta": {
        "$type": "typography",
        "$value": "{captionMedium}"
      }
    },
    "marker": {
      "size": {
        "$type": "dimension",
        "$value": "{spacing.4}"
      },
      "thickness": {
        "$type": "dimension",
        "$value": "{spacing.0.5}"
      },
      "done": {
        "surface": {
          "$type": "color",
          "$value": "{color.success.100}"
        },
        "content": {
          "$type": "color",
          "$value": "{color.success.600}"
        }
      },
      "idle": {
        "border": {
          "$type": "color",
          "$value": "{color.border-muted}"
        }
      }
    }
  }
}
