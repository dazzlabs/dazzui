{
  "segmented-control": {
    "track": {
      "padding": {
        "$type": "dimension",
        "$value": "{spacing.0.5}"
      },
      "surface": {
        "$type": "color",
        "$value": "{color.surface-muted}"
      }
    },
    "small": {
      "size": {
        "$type": "dimension",
        "$value": "{control.small.size}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.small}"
      },
      "segment": {
        "padding": {
          "inline": {
            "$type": "dimension",
            "$value": "{control.small.padding.inline}"
          }
        },
        "radius": {
          "$type": "dimension",
          "$value": "{radius.small}"
        },
        "content": {
          "$type": "typography",
          "$value": "{labelSmall}"
        }
      }
    },
    "medium": {
      "size": {
        "$type": "dimension",
        "$value": "{control.medium.size}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.medium}"
      },
      "segment": {
        "padding": {
          "inline": {
            "$type": "dimension",
            "$value": "{control.medium.padding.inline}"
          }
        },
        "radius": {
          "$type": "dimension",
          "$value": "{radius.medium}"
        },
        "content": {
          "$type": "typography",
          "$value": "{labelSmall}"
        }
      }
    },
    "large": {
      "size": {
        "$type": "dimension",
        "$value": "{control.large.size}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.large}"
      },
      "segment": {
        "padding": {
          "inline": {
            "$type": "dimension",
            "$value": "{control.large.padding.inline}"
          }
        },
        "radius": {
          "$type": "dimension",
          "$value": "{radius.large}"
        },
        "content": {
          "$type": "typography",
          "$value": "{labelMedium}"
        }
      }
    }
  }
}
