{
  "table": {
    "border": {
      "$type": "color",
      "$value": "{color.border}"
    },
    "head": {
      "surface": {
        "$type": "color",
        "$value": "{color.surface-muted}"
      },
      "content": {
        "$type": "typography",
        "$value": "{labelSmall}"
      },
      "padding": {
        "block": {
          "$type": "dimension",
          "$value": "{spacing.2}"
        }
      }
    },
    "row": {
      "padding": {
        "block": {
          "$type": "dimension",
          "$value": "{spacing.3}"
        },
        "inline": {
          "$type": "dimension",
          "$value": "{spacing.5}"
        }
      },
      "content": {
        "$type": "typography",
        "$value": "{bodySmall}"
      }
    }
  }
}
