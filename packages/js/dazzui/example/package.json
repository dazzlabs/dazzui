{
  "name": "@dazzlabs/dazzui-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The React example: every DazzUI component, live, in every theme",
  "scripts": {
    "dev": "pnpm -w run packages && vite --host 127.0.0.1 --port 6006",
    "dev:preview": "pnpm -w run packages && vite --host 0.0.0.0 --port $PORT",
    "build": "pnpm -w run packages && vite build",
    "typecheck": "tsc --noEmit",
    "conformance": "node scripts/conformance.mjs",
    "conformance:test": "node --test scripts/conformance.test.mjs",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@dazzlabs/dazzui": "workspace:*",
    "@fluentui/react-icons": "^2.0.339",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "1.63.0",
    "typescript": "~6.0.3",
    "vite": "^8.1.5",
    "wrangler": "^4.152.0"
  }
}
