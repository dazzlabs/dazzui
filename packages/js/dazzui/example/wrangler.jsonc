{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dazzui-example",
  "compatibility_date": "2026-10-26",
  // Static assets only: the example routes on ?theme= and #/page, so every
  // address is index.html and no Worker script is needed.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
