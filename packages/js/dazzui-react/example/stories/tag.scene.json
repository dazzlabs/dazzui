                        "variant": "filled"
                      },
                      "on": {
                        "select": {}
                      },
                      "children": [
                        "label"
                      ]
                    }
                  ]
                },
                {
                  "component": "Specimen",
                  "props": {
                    "label": "tinted"
                  },
                  "children": [
                    {
                      "component": "Tag",
                      "props": {
                        "selected": false,
                        "variant": "tinted"
                      },
                      "on": {
