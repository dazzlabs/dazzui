  "Interactive": {
    "state": {
      "on": true
    },
    "content": {
      "component": "Row",
      "children": [
        {
          "component": "Switch",
          "bind": {
            "checked": "on"
          },
          "props": {
            "label": "Launch at login"
          },
          "id": "switch"
        },
        {
          "component": "Inline",
          "props": {
            "tone": "muted"
          },
          "children": [
            {
              "component": "Value",
              "value": {
                "if": {
                  "state": "on"
                },
                "then": "On",
                "else": "Off"
              }
            }
          ],
          "id": "status"
        }
      ]
    },
    "checkpoints": [
      {
        "id": "initial",
        "steps": [],
        "expect": {
          "on": true
        },
        "expectText": {
          "status": "On"
        }
      },
      {
        "id": "changed",
        "steps": [
          {
            "action": "click",
            "target": "switch"
          }
        ],
        "expect": {
          "on": false
        },
        "expectText": {
          "status": "Off"
        }
      }
    ]
  },
  "AgainstACheckbox": {
    "state": {
      "live": true,
      "pending": true
    },
    "content": {
      "component": "Col",
      "props": {
        "gap": "spacing.4"
      },
      "children": [
        {
          "component": "Row",
          "children": [
            {
              "component": "Switch",
              "bind": {
                "checked": "live"
              },
              "props": {
                "label": "Dark mode"
              },
              "id": "live"
            },
            {
              "component": "Inline",
              "props": {
                "tone": "muted"
              },
              "children": [
                "Applied immediately"
              ]
            }
          ]
        },
        {
          "component": "Row",
          "children": [
            {
              "component": "Checkbox",
              "id": "pending",
              "bind": {
                "checked": "pending"
              },
              "children": [
                "Include reviewer notes"
              ]
            },
            {
              "component": "Inline",
              "props": {
                "tone": "muted"
              },
              "children": [
                "Applied when the export runs"
              ]
            }
          ]
        }
      ]
    },
    "checkpoints": [
      {
        "id": "initial",
        "steps": [],
        "expect": {
          "live": true,
          "pending": true
        }
      },
      {
        "id": "changed",
        "steps": [
          {
            "action": "click",
            "target": "live"
          },
          {
            "action": "click",
            "target": "pending"
          }
        ],
        "expect": {
          "live": false,
          "pending": false
        }
      }
    ]
  },
  "InSettings": {
    "state": {
