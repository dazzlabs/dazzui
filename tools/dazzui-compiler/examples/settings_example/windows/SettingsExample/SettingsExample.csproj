<!--
  The WinUI host for the settings example: ../Generated — the page, its
  store, and uniffi-bindgen-cs's C# for the bridge — compiled against
  the real DazzUI, with the Rust app core's DLL beside it.

  Before each build, `dazzui-compiler generate (target winui)` builds the
  core and writes ../Generated afresh, so the bindings never lag the
  library. It needs cargo and uniffi-bindgen-cs on PATH:

    dotnet build examples/settings_example/windows/SettingsExample.sln

  The smoke-test argument clicks through the page and writes result.txt and PNGs to
  DAZZUI_SMOKE_OUTPUT. It has to run in the signed-in desktop session.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>SettingsExample</AssemblyName>
    <RootNamespace>SettingsExample</RootNamespace>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <!-- uniffi-bindgen-cs writes unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Generated>$(MSBuildThisFileDirectory)../Generated/</Generated>
    <RustCore>$(MSBuildThisFileDirectory)../../../../target/debug/settings_example.dll</RustCore>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <ProjectReference Include="../../../../../../packages/csharp/DazzUI/src/DazzUI/DazzUI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Page Include="$(Generated)*.xaml" Link="Generated/%(Filename)%(Extension)" />
    <Compile Include="$(Generated)*.cs" Link="Generated/%(Filename)%(Extension)" />
    <None Include="$(RustCore)" Link="settings_example.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Before anything reads ../Generated: the file names are fixed, so the
       globs above still match what this writes. -->
  <Target Name="GenerateBridge" BeforeTargets="BeforeBuild;MarkupCompilePass1">
    <Exec Command="cargo run --quiet -p dazzui-compiler -- generate --target winui" WorkingDirectory="$(MSBuildThisFileDirectory)../.." />
  </Target>
</Project>
