{
  "name": "@dazzlabs/dazzui-conformance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "How closely each implementation draws what React draws: the viewer and the check",
  "scripts": {
    "dev": "pnpm -w run packages && vite --host 127.0.0.1 --port 5183",
    "build": "pnpm -w run packages && vite build",
    "fixtures": "node scripts/fixtures.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check.ts",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "test:collect": "node --test tests/collection.browser.mjs"
  },
  "dependencies": {
    "@dazzlabs/dazzui": "workspace:*",
    "@fluentui/react-icons": "^2.0.339",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~6.0.3",
    "vite": "^8.1.5"
  }
}
