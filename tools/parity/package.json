{
  "name": "@dazzlabs/dazzui-parity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A viewer for where the platform ports drift from the React reference",
  "scripts": {
    "dev": "pnpm -w run packages && vite --port 5182",
    "build": "pnpm -w run packages && vite build",
    "preview": "vite preview --port 5182",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dazzlabs/dazzui-react": "workspace:*",
    "@fluentui/react-icons": "^2.0.339",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~6.0.3",
    "vite": "^8.1.5"
  }
}
