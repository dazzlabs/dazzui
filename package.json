{
  "name": "dazzui",
  "version": "0.0.0",
  "private": true,
  "description": "DazzUI design system monorepo",
  "scripts": {
    "build": "pnpm run playground:build",
    "packages": "pnpm run tokens && pnpm run components",
    "tokens": "pnpm --filter @dazzlabs/dazzui-ds build",
    "components": "pnpm --filter @dazzlabs/dazzui-react build",
    "winui3": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File packages/csharp/DazzUI/scripts/run.ps1",
    "winui3:build": "dotnet build packages/csharp/DazzUI/example/Playground.csproj",
    "winui3:test": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File packages/csharp/DazzUI/scripts/run.ps1 -SmokeTest",
    "parity": "pnpm --filter @dazzlabs/dazzui-react-playground parity",
    "parity:view": "pnpm --filter @dazzlabs/dazzui-parity dev",
    "parity:flutter": "packages/dart/dazzui/example/tool/render.sh",
    "typecheck": "pnpm -r typecheck",
    "workbench": "pnpm --filter @dazzlabs/dazzui-example-workbench dev",
    "workbench:build": "pnpm --filter @dazzlabs/dazzui-example-workbench build",
    "workbench:desktop": "pnpm --filter @dazzlabs/dazzui-example-workbench desktop",
    "workbench:desktop:build": "pnpm --filter @dazzlabs/dazzui-example-workbench desktop:build",
    "canvas": "pnpm --filter @dazzlabs/dazzui-example-canvas dev",
    "canvas:build": "pnpm --filter @dazzlabs/dazzui-example-canvas build",
    "canvas:desktop": "pnpm --filter @dazzlabs/dazzui-example-canvas desktop",
    "canvas:desktop:build": "pnpm --filter @dazzlabs/dazzui-example-canvas desktop:build",
    "lint": "oxlint ./",
    "lint:fix": "oxlint ./ --fix",
    "format": "oxfmt ./",
    "format:check": "oxfmt --check ./",
    "playground": "pnpm --filter @dazzlabs/dazzui-react-playground dev",
    "playground:build": "pnpm --filter @dazzlabs/dazzui-react-playground build",
    "codegen": "pnpm --filter @dazzlabs/dazzui-codegen generate",
    "codegen:check": "pnpm --filter @dazzlabs/dazzui-codegen check",
    "codegen:test": "pnpm --filter @dazzlabs/dazzui-codegen test",
    "playground:test": "pnpm --filter @dazzlabs/dazzui-react-playground test",
    "playground:golden": "pnpm --filter @dazzlabs/dazzui-react-playground golden",
    "playground:golden:pilot": "pnpm --filter @dazzlabs/dazzui-react-playground golden:pilot",
    "codegen:complete": "pnpm --filter @dazzlabs/dazzui-codegen exec node generate.mjs --check --require-complete"
  },
  "devDependencies": {
    "oxfmt": "^0.16.0",
    "oxlint": "^1.31.0"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  }
}
