{
  "name": "dazzui",
  "version": "0.0.0",
  "private": true,
  "description": "DazzUI design system monorepo",
  "scripts": {
    "build": "pnpm run example:build",
    "packages": "pnpm run tokens && pnpm run components",
    "tokens": "pnpm --filter @dazzlabs/dazzui-ds build",
    "components": "pnpm --filter @dazzlabs/dazzui build && pnpm --filter @dazzlabs/dazzui-mobile build",
    "winui3": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File packages/csharp/DazzUI/scripts/run.ps1",
    "winui3:build": "dotnet build packages/csharp/DazzUI/example/Example.csproj",
    "winui3:test": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File packages/csharp/DazzUI/scripts/run.ps1 -SmokeTest",
    "conformance": "pnpm run packages && node tools/conformance/scripts/collect.mjs",
    "conformance:check": "pnpm --filter @dazzlabs/dazzui-conformance check",
    "conformance:view": "pnpm --filter @dazzlabs/dazzui-conformance fixtures && pnpm --filter @dazzlabs/dazzui-conformance dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint ./",
    "lint:fix": "oxlint ./ --fix",
    "format": "oxfmt ./",
    "format:check": "oxfmt --check ./",
    "example": "pnpm --filter @dazzlabs/dazzui-example dev",
    "example:build": "pnpm --filter @dazzlabs/dazzui-example build",
    "example:deploy": "pnpm --filter @dazzlabs/dazzui-example run deploy",
    "mobile": "pnpm --filter @dazzlabs/dazzui-mobile-example dev",
    "mobile:build": "pnpm --filter @dazzlabs/dazzui-mobile-example build",
    "codegen": "pnpm --filter @dazzlabs/dazzui-codegen generate",
    "codegen:check": "pnpm --filter @dazzlabs/dazzui-codegen check",
    "codegen:test": "pnpm --filter @dazzlabs/dazzui-codegen test",
    "gtk4": "cargo run --manifest-path packages/rust/dazzui-gtk4/Cargo.toml -p dazzui-gtk4-example",
    "gtk4:build": "cargo build --manifest-path packages/rust/dazzui-gtk4/Cargo.toml --workspace",
    "gtk4:test": "cargo test --manifest-path packages/rust/dazzui-gtk4/Cargo.toml --workspace",
    "gtk4:conformance": "packages/rust/dazzui-gtk4/example/tool/conformance.sh",
    "harmony:setup": "node packages/arkts/dazzui/scripts/hvigor.mjs install",
    "harmony:build": "node packages/arkts/dazzui/scripts/hvigor.mjs hap",
    "harmony:har": "node packages/arkts/dazzui/scripts/hvigor.mjs har",
    "harmony:test": "node --test ds/plugins/harmony.test.mjs ds/plugins/runtime.test.mjs tools/codegen/tests/harmony.test.mjs packages/arkts/dazzui/tests/*.test.mjs tools/harmony/*.test.mjs",
    "harmony:conformance": "node packages/arkts/dazzui/scripts/conformance.mjs",
    "harmony": "node packages/arkts/dazzui/scripts/run.mjs",
    "harmony:mobile:setup": "node packages/arkts/dazzui-mobile/scripts/hvigor.mjs install",
    "harmony:mobile:build": "node packages/arkts/dazzui-mobile/scripts/hvigor.mjs hap",
    "harmony:mobile:har": "node packages/arkts/dazzui-mobile/scripts/hvigor.mjs har",
    "harmony:mobile": "node packages/arkts/dazzui-mobile/scripts/run.mjs",
    "harmony:mobile:test": "node --test ds/plugins/harmony-mobile.test.mjs packages/arkts/dazzui-mobile/tests/*.test.mjs",
    "harmony:mobile:test:device": "node packages/arkts/dazzui-mobile/scripts/test-device.mjs",
    "harmony:test:system": "node tools/harmony/system-fonts.mjs desktop",
    "harmony:mobile:test:system": "node tools/harmony/system-fonts.mjs mobile",
    "harmony:test:device": "node tools/harmony/gallery-test.mjs --all",
    "nsh": "cargo run --manifest-path packages/rust/dazzui-nsh/Cargo.toml -p dazzui-nsh-example",
    "nsh:build": "cargo build --manifest-path packages/rust/dazzui-nsh/Cargo.toml --workspace",
    "nsh:test": "cargo test --manifest-path packages/rust/dazzui-nsh/Cargo.toml --workspace",
    "nsh:test:native": "node packages/rust/dazzui-nsh/example/tool/native-test.mjs",
    "nsh:conformance": "node packages/rust/dazzui-nsh/example/tool/conformance.mjs",
    "nsh:web": "nsh run packages/rust/dazzui-nsh/example --target web",
    "nsh:web:build": "node packages/rust/dazzui-nsh/example/tool/web-build.mjs",
    "nsh:web:deploy": "pnpm nsh:web:build && wrangler deploy --config packages/rust/dazzui-nsh/example/wrangler.jsonc",
    "nsh:web:test": "node packages/rust/dazzui-nsh/example/tool/web-test.mjs"
  },
  "devDependencies": {
    "oxfmt": "^0.16.0",
    "oxlint": "^1.31.0",
    "wrangler": "^4.152.0"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  }
}
