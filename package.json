{
  "name": "dazzui",
  "version": "0.0.0",
  "private": true,
  "description": "DazzUI design system monorepo",
  "scripts": {
    "build": "pnpm run packages && pnpm run storybook:build",
    "packages": "pnpm run tokens && pnpm run components",
    "tokens": "pnpm --filter @dazzlabs/dazzui-ds build",
    "components": "pnpm --filter @dazzlabs/dazzui-react build",
    "winui3": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File packages/ui_winui3/scripts/run.ps1",
    "winui3:build": "dotnet build packages/ui_winui3/example/Playground.csproj",
    "winui3:test": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File packages/ui_winui3/scripts/run.ps1 -SmokeTest",
    "parity": "pnpm --filter @dazzlabs/dazzui-storybook parity",
    "parity:view": "pnpm --filter @dazzlabs/dazzui-parity dev",
    "parity:flutter": "packages/ui_flutter/example/tool/render.sh",
    "typecheck": "pnpm -r typecheck",
    "storybook": "pnpm --filter @dazzlabs/dazzui-storybook dev",
    "storybook:build": "pnpm --filter @dazzlabs/dazzui-storybook build",
    "workbench": "pnpm --filter @dazzlabs/dazzui-example-workbench dev",
    "workbench:build": "pnpm --filter @dazzlabs/dazzui-example-workbench build",
    "workbench:desktop": "pnpm --filter @dazzlabs/dazzui-example-workbench desktop",
    "workbench:desktop:build": "pnpm --filter @dazzlabs/dazzui-example-workbench desktop:build",
    "canvas": "pnpm --filter @dazzlabs/dazzui-example-canvas dev",
    "canvas:build": "pnpm --filter @dazzlabs/dazzui-example-canvas build",
    "canvas:desktop": "pnpm --filter @dazzlabs/dazzui-example-canvas desktop",
    "canvas:desktop:build": "pnpm --filter @dazzlabs/dazzui-example-canvas desktop:build",
    "lint": "oxlint ./",
    "lint:fix": "oxlint ./ --fix",
    "format": "oxfmt ./",
    "format:check": "oxfmt --check ./"
  },
  "devDependencies": {
    "oxfmt": "^0.16.0",
    "oxlint": "^1.31.0"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  }
}
