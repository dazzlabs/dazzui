{
  "name": "@dazzlabs/dazzui-storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design token gallery for DazzUI",
  "scripts": {
    "dev": "pnpm --filter @dazzlabs/dazzui-tokens build && storybook dev --port 6006 --no-open",
    "build": "pnpm --filter @dazzlabs/dazzui-tokens build && storybook build --output-dir dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dazzlabs/dazzui-tokens": "workspace:*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "storybook": "^10.5.5",
    "typescript": "~6.0.3",
    "vite": "^8.1.5"
  }
}
