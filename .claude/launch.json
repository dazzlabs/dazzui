{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "example",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@dazzlabs/dazzui-example",
        "dev:preview"
      ],
      "port": 6006,
      "autoPort": true
    },
    {
      "name": "ui-flutter-example",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8321",
        "-d",
        "packages/dart/dazzui/example/build/web"
      ],
      "port": 8321
    },
    {
      "name": "conformance",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@dazzlabs/dazzui-conformance",
        "dev"
      ],
      "port": 5183,
      "autoPort": true
    },
    {
      "name": "mobile-example",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@dazzlabs/dazzui-mobile-example",
        "exec",
        "vite",
        "--host",
        "127.0.0.1",
        "--port",
        "6007"
      ],
      "port": 6007
    }
  ]
}
