{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@dazzlabs/dazzui-storybook",
        "dev:preview"
      ],
      "port": 6006,
      "autoPort": true
    },
    {
      "name": "ui-flutter-example",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8321",
        "-d",
        "packages/ui_flutter/example/build/web"
      ],
      "port": 8321
    }
  ]
}
